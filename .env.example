# GeoAtlas Environment Configuration Template
# Copy this file to .env on the server and fill in real secrets. Never commit .env!

ENVIRONMENT=production
CARTO_KEY=
ALLOWED_ORIGINS=https://geoatlas.sfedu.ru

# Storage paths inside container
GEOATLAS_DATA_DIR=/app/data
DUEL_DATA_DIR=/app/data

# Session & token signing secret (generate a long random string in production)
AUTH_SESSION_SECRET=

# Trusted university email domains (comma-separated)
TRUSTED_UNIVERSITY_DOMAINS=sfedu.ru

# SMTP mail delivery settings
MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=GeoAtlas ЮФУ
SMTP_USE_TLS=true

# Optional Official University OIDC / Microsoft Entra ID (leave disabled until IT provides credentials)
AUTH_OIDC_ENABLED=false
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REDIRECT_URI=https://geoatlas.sfedu.ru/api/auth/oidc/callback
AUTH_OIDC_TENANT_ID=

# Feature flags
RUSSIA_MAP_ENABLED=false
